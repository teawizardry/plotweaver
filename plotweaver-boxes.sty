\ProvidesPackage{plotweaver-boxes}[2026-09-01 Plotweaver Boxes]
\RequirePackage{plotweaver-colors}
\DeclareKeys[plotweaver-boxes]{
    color.code = \colorlet{cscolor}{#1},
    accent-color.code = \colorlet{csaccent}{#1},
    callout-color.code = \colorlet{cscalloutbg}{#1},
    text-color.code = \colorlet{cstextcolor}{#1}
}
\ProcessKeyOptions

\RequirePackage{tikz}
\RequirePackage[poster]{tcolorbox}
\tcbuselibrary{skins, raster}
\usetikzlibrary{backgrounds, calc, chains, decorations.pathmorphing, positioning, arrows.meta, bending, shadows.blur, shapes.geometric, shadings}
\pgfdeclarelayer{foreground}
\pgfsetlayers{background,main,foreground}

\newcounter{mathseed}
\setcounter{mathseed}{3}
\pgfmathsetseed{\arabic{mathseed}}

\pgfdeclaredecoration{irregular fractal line}{init}{
  \state{init}[width=\pgfdecoratedinputsegmentremainingdistance]{
    \pgfpathlineto{\pgfpoint{random*\pgfdecoratedinputsegmentremainingdistance}{(random*\pgfdecorationsegmentamplitude-0.02)*\pgfdecoratedinputsegmentremainingdistance}}
    \pgfpathlineto{\pgfpoint{\pgfdecoratedinputsegmentremainingdistance}{0pt}}
  }
}

\tikzset{
  paper/.style={
    draw=none, blur shadow={shadow scale=1, shadow blur radius=5pt, shadow blur steps=10, shadow xshift=-0.1pt},
    lower left=cscalloutbg!80!cscolor, upper left=cscalloutbg!95!cscolor,
    upper right=cscalloutbg, lower right=cscalloutbg!85!cscolor,
    fill=none
  },
  irregular border/.style={
    decoration={irregular fractal line, amplitude=0.125},
    decorate,
  },
  ragged border/.style={
    decoration={random steps, segment length=7mm, amplitude=2mm},
    decorate,
  }
}

