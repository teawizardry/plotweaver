% table styling
\NewDocumentEnvironment{CharTable}{m m}{%
    \centering
    \setlength{\tabcolsep}{0.5em}
    \begin{NiceTabularX}{#1}{#2}
        \CodeBefore
            \rowcolor{plotweavergray!85!black}{1}
            \rowcolors{2}{plotweavergray!50}{white}
        \Body
        \RowStyle[nb-rows=1,color=white]{\bfseries}
}{%
    \end{NiceTabularX}
}

